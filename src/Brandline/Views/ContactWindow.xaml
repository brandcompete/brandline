<Window x:Class="Brandline.Views.ContactWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Brandline.Views"
        Title="Kontakt" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontSize="14">
    <StackPanel Margin="20">
        <!-- Avatar -->
        <DockPanel>
            <v:AvatarView x:Name="AvatarPreview" Diameter="72" Margin="0,0,16,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Avatar" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Bild wählen …" Click="OnChooseAvatar" Padding="12,5" Margin="0,0,8,0"/>
                    <Button x:Name="RemoveAvatarButton" Content="Entfernen" Click="OnRemoveAvatar" Padding="12,5"/>
                </StackPanel>
                <TextBlock Text="JPG, PNG oder BMP – wird quadratisch zugeschnitten." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,18,0,4"/>
        <TextBox x:Name="NameBox" TextChanged="OnNameChanged"/>
        <TextBlock Text="Firma" Style="{StaticResource Label}"/>
        <TextBox x:Name="CompanyBox"/>
        <TextBlock Text="Telefonnummern" Style="{StaticResource Label}"/>
        <!-- Eine Zeile pro Nummer: Nummer, Art (Standard Mobil), entfernen. Die erste ist die Hauptnummer. -->
        <ItemsControl x:Name="NumberList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                Padding="9,6" Margin="6,0,0,0" ToolTip="Nummer entfernen" Click="OnRemoveNumber" Tag="{Binding}"/>
                        <ComboBox DockPanel.Dock="Right" Width="120" Margin="6,0,0,0"
                                  ItemsSource="{x:Static v:ContactWindow.TypeOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Type" SelectedValue="{Binding Type}"/>
                        <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="+ Weitere Nummer" Click="OnAddNumber" HorizontalAlignment="Left" Padding="10,3" FontSize="12"/>
        <TextBlock Text="Notiz" Style="{StaticResource Label}"/>
        <TextBox x:Name="NoteBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Speichern" IsDefault="True" Style="{StaticResource AccentButton}" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
