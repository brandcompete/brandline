<Window x:Class="Brandline.Views.TransferWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Brandline.Views"
        Title="Weiterleiten" Width="420" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontSize="14">
    <DockPanel Margin="20">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,10"
                   Text="Nummer eingeben oder Kontakt wählen. „Direkt“ übergibt sofort; „Rückfrage“ ruft das Ziel zuerst an – das aktuelle Gespräch wird gehalten und danach mit „Verbinden“ übergeben."/>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" FontSize="18" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Rückfrage" Click="OnConsult" Margin="0,0,8,0"
                    ToolTip="Ziel zuerst anrufen, das aktuelle Gespräch wird gehalten"/>
            <Button Content="Direkt weiterleiten" Style="{StaticResource AccentButton}" Click="OnBlind" IsDefault="True"/>
        </StackPanel>

        <ListBox x:Name="Matches" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch" SelectionChanged="OnMatchSelected" MouseDoubleClick="OnMatchDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,3">
                        <v:AvatarView DisplayName="{Binding Name}" Image="{Binding Image}" Diameter="30" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Heading}"/>
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
