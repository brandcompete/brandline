<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Eigene GlobalUsings.cs: die impliziten Usings von WinForms (Tray-Symbol) kollidieren mit WPF. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Für den handgebauten COM-Puffer der Windows-Echounterdrückung -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>brandline</AssemblyName>
    <RootNamespace>Brandline</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>brandline</AssemblyTitle>
    <Product>brandline</Product>
    <Company>brandcompete</Company>
    <Version>0.4.0</Version>
    <Copyright>© brandcompete GmbH</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hausschrift Rubik (SIL Open Font License, siehe Fonts/OFL-Rubik.txt) -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL-Rubik.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Erzeugt mit tools\Generate-ThirdPartyNotices.ps1 -->
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
