<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    MSI-Installer für brandline (WiX Toolset 5, wird als NuGet-SDK geladen – keine separate Installation nötig).
    Bauen über tools\Build-Installer.ps1; das Skript veröffentlicht vorher die App nach artifacts\app.
  -->
  <PropertyGroup>
    <OutputName>brandline-$(ProductVersion)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>de-DE</Cultures>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <AppDir Condition="'$(AppDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\app</AppDir>
    <DefaultsJson Condition="'$(DefaultsJson)' == ''">$(MSBuildThisFileDirectory)defaults.json</DefaultsJson>
    <DefineConstants>ProductVersion=$(ProductVersion);AppDir=$(AppDir);DefaultsJson=$(DefaultsJson)</DefineConstants>
    <!-- ICE-Hinweise zum Startmenü-Verknüpfungspfad bei Pro-Computer-Installation sind hier erwartbar -->
    <SuppressIces>ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
