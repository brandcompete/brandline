<?xml version="1.0" encoding="utf-8"?>
<!--
  brandline – MSI-Paket (Pro-Computer-Installation, 64 Bit)

  Ablauf:
  * Installation nach C:\Program Files\brandcompete\brandline, Startmenü-Eintrag, Eintrag unter „Apps“.
  * Firewall-Regel für brandline.exe (eingehend, alle Profile), damit eingehende Anrufe ankommen –
    dafür braucht die Installation einmalig Administratorrechte (UAC).
  * Vor Update/Deinstallation wird eine laufende App über „brandline.exe exit“ sauber beendet
    (Abmeldung bei Placetel), bei der Deinstallation zusätzlich Autostart und tel:-Links des Benutzers entfernt.
  * Die UpgradeCode-GUID darf sich nie ändern – sonst werden Updates als zweites Produkt installiert.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="brandline"
           Manufacturer="brandcompete GmbH"
           Version="$(var.ProductVersion)"
           UpgradeCode="3B7F3F7A-7186-4DE8-8D48-6A90BF408C72"
           Scope="perMachine"
           Language="1031"
           Codepage="1252">

    <SummaryInformation Description="brandline – SIP-Softphone von brandcompete" Manufacturer="brandcompete GmbH" />

    <MajorUpgrade DowngradeErrorMessage="Es ist bereits eine neuere Version von brandline installiert." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Anzeige unter „Apps &amp; Features“ -->
    <Icon Id="AppIcon.ico" SourceFile="..\src\Brandline\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.brandcompete.com" />
    <Property Id="ARPHELPLINK" Value="mailto:office@brandcompete.com" />
    <Property Id="ARPCONTACT" Value="brandcompete GmbH" />

    <!-- ========== Verzeichnisse und Dateien ========== -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="brandcompete">
        <Directory Id="INSTALLFOLDER" Name="brandline" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Installationsordner ist im Installer wählbar (Standard: oben). Bei Updates wird der zuletzt gewählte
         Ordner aus der Registry übernommen, sonst landete die neue Version im Standardordner und die alte
         bliebe verwaist liegen. Per Kommandozeile: msiexec /i brandline.msi INSTALLFOLDER="D:\Apps\brandline" -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\brandcompete\brandline"
                      Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="InstallFolderRegistry" Guid="*">
        <RegistryValue Root="HKLM" Key="Software\brandcompete\brandline" Name="InstallFolder"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
      <Component Id="MainExecutable" Guid="*">
        <File Id="BrandlineExe" Source="$(var.AppDir)\brandline.exe" KeyPath="yes">
          <!-- Eingehende SIP/RTP-Verbindungen erlauben (sonst kommen eingehende Anrufe nicht an) -->
          <fw:FirewallException Id="BrandlineFirewall" Name="brandline (SIP-Softphone)"
                                Scope="any" Profile="all" IgnoreFailure="yes"
                                Description="Eingehende Anrufe und Sprachdaten für brandline" />
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="brandline"
                    Description="SIP-Softphone von brandcompete" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>
      </Component>
      <!-- Alle übrigen Dateien der veröffentlichten App: .NET-Laufzeit, WPF-Bibliotheken, Lizenzhinweise.
           Bewusst kein „Single-File“: dabei würden Teile beim ersten Start nach %TEMP% entpackt und von dort
           ausgeführt – das blockieren AppLocker/Virenscanner auf Firmenrechnern häufig. -->
      <Files Include="$(var.AppDir)\**">
        <Exclude Files="$(var.AppDir)\brandline.exe" />
      </Files>
      <!-- Startwerte für neue Benutzer; von der IT im Installationsordner anpassbar -->
      <Component Id="Defaults" Guid="*">
        <File Id="DefaultsJson" Source="$(var.DefaultsJson)" Name="defaults.json" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="brandline" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!-- ========== Laufende App vor Update/Deinstallation beenden ========== -->
    <CustomAction Id="CloseRunningBrandline" FileRef="BrandlineExe" ExeCommand="--exit"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="CleanupUserIntegration" FileRef="BrandlineExe" ExeCommand="--uninstall-cleanup"
                  Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <!-- Update bzw. Reparatur: nur beenden -->
      <Custom Action="CloseRunningBrandline" Before="InstallValidate"
              Condition="WIX_UPGRADE_DETECTED OR (Installed AND NOT REMOVE~=&quot;ALL&quot;)" />
      <!-- Deinstallation (kein Update): beenden und Autostart/tel:-Links entfernen -->
      <Custom Action="CleanupUserIntegration" Before="InstallValidate"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- ========== Oberfläche ========== -->
    <!-- Willkommen → Lizenz → Installationsordner wählen → Installieren → Fertig -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="Assets\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="Assets\banner.bmp" />

    <!-- „brandline jetzt starten“ am Ende der Installation (läuft mit den Rechten des Benutzers) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="brandline jetzt starten" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchBrandline" FileRef="BrandlineExe" ExeCommand="--show" Return="asyncNoWait" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchBrandline"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
